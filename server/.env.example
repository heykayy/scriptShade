# Copy this file to .env and fill in the providers you want to enable.
# Any provider left blank simply won't be selectable in the app (demo mode always works).

PORT=8787

# Required — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Database (Turso — hosted, SQLite-compatible, free tier) ─────────────────
# Create a free database with the Turso CLI or dashboard (https://turso.tech),
# then paste its URL and auth token here. Data lives on Turso, not on this
# server's local disk, so it survives redeploys/restarts on hosts like Render's
# free tier that don't give you a persistent disk.
#   turso db create scriptshade
#   turso db show scriptshade --url
#   turso db tokens create scriptshade
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── OAuth ──────────────────────────────────────────────────────────────────
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL for OAuth callbacks, set it to deployed backend URL. For Docker local use, set this to
# http://localhost:8080 because nginx publishes the app on port 8080.
# For node runtime, set it to http://localhost:8787 because the backend 
# is directly exposed on port 8787. 
OAUTH_REDIRECT_BASE=

# Frontend base URL (for redirects after OAuth) – e.g., http://localhost:5173 (for node runtime) 
# or http://localhost:8080 (for Docker local use). 
# Set it to your deployed frontend URL when deploying.
FRONTEND_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API, e.g.:
#   CORS_ORIGIN=https://your-app.vercel.app
# Leave blank while testing locally; set it once you have a real frontend URL,
# so future URL changes are just an env var edit, not a code change.
CORS_ORIGIN=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Developer / master login (completely separate from regular accounts) ────
# Both required together to enable the /developer login. This email is also
# reserved — nobody can sign up or log in as it through the normal user flow.
ADMIN_EMAIL=
ADMIN_PASSWORD=
